{
  "name": "orbit",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"server,vite\" -c \"cyan,magenta\" \"node --watch server.js\" \"vite\"",
    "dev:vite": "vite",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "build:prod": "vite build && cross-env NODE_ENV=production node server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "vite": "^5.0.8"
  }
}
